+pub fn encrypt_persisted_state(
+    purpose: &str,
+    plaintext: &[u8],
+) -> Result<Vec<u8>, KeystoreError> {
+    validate_purpose(purpose)?;
+    let purpose_bytes = purpose.as_bytes();
+    let mut envelope = Vec::with_capacity(2 + purpose_bytes.len() + plaintext.len());
+    envelope.extend_from_slice(&(purpose_bytes.len() as u16).to_be_bytes());
+    envelope.extend_from_slice(purpose_bytes);
+    envelope.extend_from_slice(plaintext);
