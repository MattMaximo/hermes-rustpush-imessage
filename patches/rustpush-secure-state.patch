+/// Install the process-local key used to protect rustpush state at rest.
+/// The key is expected to come from the local OS credential store. A second
+/// initialization is accepted only when it supplies the identical key.
+pub fn init_persisted_state_encryption(key: [u8; 32]) -> Result<(), KeystoreError> {
+    if let Some(existing) = PERSISTED_STATE_KEY.get() {
+        if existing == &key {
+            return Ok(());
+        }
+        return Err(KeystoreError::KeystoreError(
+            "persisted-state encryption already initialized with a different key".into(),
+        ));
+    }
+    PERSISTED_STATE_KEY.set(key).map_err(|_| {
+        KeystoreError::KeystoreError("failed to initialize persisted-state encryption".into())
+    })
+}
