+            KeystoreError::KeystoreError("failed to write persisted state".into())
+        })?;
+        file.sync_all().map_err(|_| {
+            KeystoreError::KeystoreError("failed to sync persisted state".into())
+        })?;
+        std::fs::rename(&temp_path, path).map_err(|_| {
+            KeystoreError::KeystoreError("failed to replace persisted state".into())
+        })?;
+        #[cfg(unix)]
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600)).map_err(|_| {
+            KeystoreError::KeystoreError("failed to secure persisted-state file".into())
+        })?;
+        if let Ok(directory) = std::fs::File::open(parent) {
+            let _ = directory.sync_all();
+        }
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&temp_path);
+    }
+    result
+}
