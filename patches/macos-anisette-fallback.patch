+#[cfg(all(target_os = "macos", feature = "remote-anisette-v3"))]
+pub struct FallbackAnisetteProvider {
+    local: Option<AOSKitAnisetteProvider<'static>>,
+    remote: RemoteAnisetteProviderV3,
+}
+
+#[cfg(all(target_os = "macos", feature = "remote-anisette-v3"))]
+fn aoskit_headers_usable(headers: &HashMap<String, String>) -> bool {
+    ["X-Apple-I-MD", "X-Apple-I-MD-M"]
+        .iter()
+        .all(|key| headers.get(*key).is_some_and(|value| !value.trim().is_empty()))
+}
+
+#[cfg(all(target_os = "macos", feature = "remote-anisette-v3"))]
+impl AnisetteProvider for FallbackAnisetteProvider {
+    async fn get_anisette_headers(
+        &mut self,
+    ) -> Result<HashMap<String, String>, AnisetteError> {
+        if let Some(local) = self.local.as_mut() {
+            match local.get_anisette_headers().await {
+                Ok(headers) if aoskit_headers_usable(&headers) => return Ok(headers),
+                Ok(_) => log::warn!("AOSKit anisette headers were incomplete; using the provisioned fallback"),
+                Err(_) => log::warn!("AOSKit anisette headers were unavailable; using the provisioned fallback"),
+            }
+        }
+        match self.remote.get_anisette_headers().await {
+            Ok(headers) => Ok(headers),
+            Err(_) => self.remote.get_anisette_headers().await,
+        }
+    }
+}
+
+#[cfg(all(target_os = "macos", feature = "remote-anisette-v3"))]
+pub type DefaultAnisetteProvider = FallbackAnisetteProvider;
+#[cfg(all(target_os = "macos", feature = "remote-anisette-v3"))]
+pub fn default_provider(info: LoginClientInfo, path: PathBuf) -> ArcAnisetteClient<DefaultAnisetteProvider> {
+    Arc::new(Mutex::new(AnisetteClient::new(FallbackAnisetteProvider {
+        local: AOSKitAnisetteProvider::new().ok(),
+        remote: RemoteAnisetteProviderV3::new(
+            DEFAULT_ANISETTE_URL_V3.to_string(),
+            info,
+            path,
+        ),
+    })))
+}
+
