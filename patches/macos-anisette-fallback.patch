+fn required_nsstring(value: *const NSString, label: &str) -> Result<String, AnisetteError> {
+    if value.is_null() {
+        return Err(AnisetteError::Anyhow(anyhow::anyhow!(
+            "AOSKit returned no {label}"
+        )));
+    }
+    let text = unsafe { (*value).as_str() }.trim().to_string();
+    if text.is_empty() {
+        return Err(AnisetteError::Anyhow(anyhow::anyhow!(
+            "AOSKit returned an empty {label}"
+        )));
+    }
+    Ok(text)
+}
