+const STATE_KEYCHAIN_SERVICE: &str = "ai.hermes.rustpush";
+const STATE_KEYCHAIN_ACCOUNT: &str = "state-encryption-key.v1";
+const KEYSTORE_STATE_PURPOSE: &str = "keystore.plist";
+static SECURE_RUNTIME_RESULT: OnceLock<Result<(), String>> = OnceLock::new();
+
+fn wrapped_security_error(message: impl Into<String>) -> WrappedError {
+    WrappedError::GenericError {
+        msg: message.into(),
+    }
+}
+
+#[cfg(target_os = "macos")]
+fn load_or_create_state_key() -> Result<[u8; 32], String> {
+    use security_framework::passwords::{get_generic_password, set_generic_password};
+    use security_framework::random::SecRandom;
+
+    const ITEM_NOT_FOUND: i32 = -25300;
+
+    fn key_from_bytes(mut bytes: Vec<u8>) -> Result<[u8; 32], String> {
+        if bytes.len() != 32 {
+            bytes.fill(0);
+            return Err("macOS Keychain rustpush state key has an invalid length".into());
+        }
+        let mut key = [0u8; 32];
+        key.copy_from_slice(&bytes);
+        bytes.fill(0);
+        Ok(key)
+    }
+
+    match get_generic_password(STATE_KEYCHAIN_SERVICE, STATE_KEYCHAIN_ACCOUNT) {
+        Ok(bytes) => key_from_bytes(bytes),
+        Err(error) if error.code() == ITEM_NOT_FOUND => {
+            let mut generated = [0u8; 32];
+            SecRandom::default()
+                .copy_bytes(&mut generated)
+                .map_err(|_| "failed to generate the rustpush state key".to_string())?;
+            set_generic_password(
+                STATE_KEYCHAIN_SERVICE,
+                STATE_KEYCHAIN_ACCOUNT,
+                &generated,
+            )
+            .map_err(|error| {
+                format!(
+                    "failed to store the rustpush state key in macOS Keychain (OSStatus {})",
+                    error.code()
+                )
+            })?;
+
+            let verified = get_generic_password(STATE_KEYCHAIN_SERVICE, STATE_KEYCHAIN_ACCOUNT)
+                .map_err(|error| {
+                    format!(
+                        "failed to verify the rustpush state key in macOS Keychain (OSStatus {})",
+                        error.code()
+                    )
+                })?;
+            let verified = key_from_bytes(verified)?;
+            if verified != generated {
+                generated.fill(0);
+                return Err("macOS Keychain rustpush state-key verification failed".into());
+            }
+            Ok(generated)
+        }
+        Err(error) => Err(format!(
+            "failed to read the rustpush state key from macOS Keychain (OSStatus {})",
+            error.code()
+        )),
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+fn load_or_create_state_key() -> Result<[u8; 32], String> {
+    Err("Keychain-backed rustpush state is supported only on macOS".into())
+}
+
+fn initialize_secure_runtime_inner() -> Result<(), String> {
+    let key = load_or_create_state_key()?;
+    init_persisted_state_encryption(key)
+        .map_err(|_| "failed to initialize rustpush state encryption".to_string())?;
+
+    let xdg_dir = resolve_xdg_data_dir();
+    let state_path = PathBuf::from(&xdg_dir).join("keystore.plist.enc");
+    let state = match read_persisted_state(&state_path, KEYSTORE_STATE_PURPOSE)
+        .map_err(|_| "failed to decrypt the rustpush software keystore".to_string())?
+    {
+        Some(mut plaintext) => {
+            let parsed = plist::from_bytes::<SoftwareKeystoreState>(&plaintext)
+                .map_err(|_| {
+                    "failed to parse the decrypted rustpush software keystore".to_string()
+                });
+            plaintext.fill(0);
+            parsed?
+        }
+        None => SoftwareKeystoreState::default(),
+    };
+
+    let persist_path = state_path.clone();
+    init_keystore(SoftwareKeystore {
+        state: std::sync::RwLock::new(state),
+        update_state: Box::new(move |state| {
+            let mut plaintext = Vec::new();
+            plist::to_writer_binary(&mut plaintext, state)
+                .expect("failed to serialize the rustpush software keystore");
+            write_persisted_state(&persist_path, KEYSTORE_STATE_PURPOSE, &plaintext)
+                .expect("failed to persist the encrypted rustpush software keystore");
+            plaintext.fill(0);
+        }),
+        encryptor: SoftwareEncryptor(key),
+    });
+    Ok(())
+}
+
+fn ensure_secure_runtime() -> Result<(), WrappedError> {
+    match SECURE_RUNTIME_RESULT.get_or_init(initialize_secure_runtime_inner) {
+        Ok(()) => Ok(()),
+        Err(message) => Err(wrapped_security_error(message.clone())),
+    }
+}
+
+/// Initialize the Keychain-backed state-encryption boundary before making any
+/// Apple network connection. This function is idempotent and fails closed.
+#[uniffi::export]
+pub fn init_secure_runtime() -> Result<(), WrappedError> {
+    ensure_secure_runtime()
+}
+
+/// Encrypt adapter-owned rustpush state for local persistence.
+#[uniffi::export]
+pub fn protect_state(purpose: String, mut plaintext: Vec<u8>) -> Result<Vec<u8>, WrappedError> {
+    ensure_secure_runtime()?;
+    let result = encrypt_persisted_state(&purpose, &plaintext)
+        .map_err(|_| wrapped_security_error("failed to encrypt rustpush state"));
+    plaintext.fill(0);
+    result
+}
+
+/// Decrypt adapter-owned rustpush state. Plaintext and purpose mismatches are
+/// rejected; there is deliberately no insecure migration fallback.
+#[uniffi::export]
+pub fn unprotect_state(purpose: String, mut protected: Vec<u8>) -> Result<Vec<u8>, WrappedError> {
+    ensure_secure_runtime()?;
+    let result = decrypt_persisted_state(&purpose, &protected)
+        .map_err(|_| wrapped_security_error("failed to decrypt rustpush state"));
+    protected.fill(0);
+    result
+}
